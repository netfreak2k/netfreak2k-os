[Unit]
Description=Netfreak2k Home Assistant access proxy
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:8123,reuseaddr,fork TCP:192.168.122.50:80
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
